<%- include('partials/header', { title: title }) %>

<main>
    <h1>Our Partner Organizations</h1>
    <p>We work closely with these amazing organizations to deliver community projects.</p>
    
    <div class="org-grid" style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <div class="org-card" style="flex: 1; min-width: 250px;">
            <img src="/images/org1.jpg" alt="Organization One" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px;">
            <h3>Green Earth Initiative</h3>
            <p>Focused on local environmental cleanups and tree planting.</p>
        </div>
        
        <div class="org-card" style="flex: 1; min-width: 250px;">
            <img src="/images/org2.jpg" alt="Organization Two" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px;">
            <h3>Youth Education Fund</h3>
            <p>Providing tutoring and school supplies for underprivileged students.</p>
        </div>
        
        <div class="org-card" style="flex: 1; min-width: 250px;">
            <img src="/images/org3.jpg" alt="Organization Three" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px;">
            <h3>Community Health Outreach</h3>
            <p>Hosting wellness camps and health awareness seminars.</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>