<%- include('partials/header') %>

<main class="edit-project-container">

    <h1>Edit Project</h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">

        <!-- Project Title -->
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
            >
        </div>

        <!-- Project Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="5"
                required
            ><%= project.description %></textarea>
        </div>

        <!-- Project Location -->
        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location || '' %>"
                required
            >
        </div>

        <!-- Project Date -->
        <div class="form-group">
            <label for="date">Project Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= project.date ? new Date(project.date).toISOString().split('T')[0] : '' %>"
                required
            >
        </div>

        <!-- Organization -->
        <div class="form-group">
            <label for="organization_id">Organization</label>

            <select
                id="organization_id"
                name="organization_id"
                required
            >

                <% organizations.forEach(organization => { %>

                    <option
                        value="<%= organization.organization_id %>"
                        <%= organization.organization_id === project.organization_id ? 'selected' : '' %>
                    >
                        <%= organization.name %>
                    </option>

                <% }); %>

            </select>
        </div>

        <!-- Buttons -->
        <div class="form-actions">
            <button type="submit">Save Changes</button>

            <a href="/project/<%= project.project_id %>">
                Cancel
            </a>
        </div>

    </form>

</main>

<%- include('partials/footer') %>