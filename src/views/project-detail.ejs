<main>
  <h1><%= project.project_name %></h1>
  <p><%= project.description %></p>
  <p>Start Date: <%= project.start_date %></p>

  <!-- PASTE THE CATEGORY TAGS CODE HERE -->
  <div class="project-categories">
    <h3>Categories</h3>
    <% if (locals.categories && categories.length > 0) { %>
      <ul class="tag-list">
        <% categories.forEach(cat => { %>
          <li>
            <a href="/category/<%= cat.category_id %>" class="tag-link">
              <%= cat.category_name %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No categories assigned to this project.</p>
    <% } %>
  </div>
</main>