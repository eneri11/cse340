<%- include('partials/header') %>

<main class="project-detail-container">

    <h1><%= project.title %></h1>
    <% if (user && user.role_name === 'admin') { %>

    <a
        href="/edit-project/<%= project.project_id %>"
        class="edit-project-link"
    >
        Edit Project
    </a>

    <a
        href="/project/<%= project.project_id %>/categories"
        class="update-categories-link"
    >
        Update Categories
    </a>

<% } %>

    <p class="project-meta">
        <strong>Date:</strong>
        <%= project.date ? new Date(project.date).toLocaleDateString() : 'TBD' %>
        <br>

        <strong>Location:</strong>
        <%= project.location || 'Not specified' %>
    </p>

    <p>
        <strong>Organization:</strong>

        <% if (project.organization_id) { %>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        <% } else { %>
            Not specified
        <% } %>
    </p>

    <div class="project-description">
        <h2>About this Project</h2>
        <p><%= project.description %></p>
    </div>

    <div class="project-categories">
        <h2>Categories</h2>

        <% if (categories && categories.length > 0) { %>

            <ul class="tag-list">

                <% categories.forEach(category => { %>

                    <li>
                        <a
                            href="/category/<%= category.category_id %>"
                            class="category-tag"
                        >
                            <%= category.name %>
                        </a>
                    </li>

                <% }); %>

            </ul>

        <% } else { %>

            <p>No categories assigned to this project.</p>

        <% } %>

    </div>

    <section class="volunteer-section">

    <% if (user) { %>

        <% if (isVolunteer) { %>

            <p>
                <strong>You are volunteering for this project.</strong>
            </p>

            <form
                action="/project/<%= project.project_id %>/volunteer/remove"
                method="POST"
            >
                <button type="submit">
                    Remove Me as a Volunteer
                </button>
            </form>

        <% } else { %>

            <form
                action="/project/<%= project.project_id %>/volunteer"
                method="POST"
            >
                <button type="submit">
                    Volunteer for This Project
                </button>
            </form>

        <% } %>

    <% } %>

</section>

</main>

<%- include('partials/footer') %>