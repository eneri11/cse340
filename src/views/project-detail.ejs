<%- include('partials/header') %>

<main class="project-detail-container">

    <h1><%= project.title %></h1>
    <a
    href="/edit-project/<%= project.project_id %>"
    class="edit-project-link"
>
    Edit Project
</a>

    <p class="project-meta">
        <strong>Date:</strong>
        <%= project.date ? new Date(project.date).toLocaleDateString() : 'TBD' %>
        <br>

        <strong>Location:</strong>
        <%= project.location || 'Not specified' %>
    </p>

    <p>
        <strong>Organization:</strong>

        <% if (project.organization_id) { %>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        <% } else { %>
            Not specified
        <% } %>
    </p>

    <div class="project-description">
        <h2>About this Project</h2>
        <p><%= project.description %></p>
    </div>

    <div class="project-categories">
        <h2>Categories</h2>

        <% if (categories && categories.length > 0) { %>

            <ul class="tag-list">

                <% categories.forEach(category => { %>

                    <li>
                        <a
                            href="/category/<%= category.category_id %>"
                            class="category-tag"
                        >
                            <%= category.name %>
                        </a>
                    </li>

                <% }); %>

            </ul>

        <% } else { %>

            <p>No categories assigned to this project.</p>

        <% } %>

    </div>

</main>

<%- include('partials/footer') %>