<main class="project-detail-container">
  <h1><%= project.title %></h1>
  
  <p class="project-meta">
    <strong>Date:</strong> <%= project.date ? new Date(project.date).toLocaleDateString() : 'TBD' %><br>
    <strong>Location:</strong> <%= project.location || 'Not specified' %>
  </p>

  <div class="project-description">
    <h3>About this Project</h3>
    <p><%= project.description %></p>
  </div>

  <!-- Category Tags Section -->
  <div class="project-categories">
    <h3>Categories</h3>
    <% if (categories && categories.length > 0) { %>
      <ul class="tag-list">
        <% categories.forEach(category => { %>
          <li>
            <a href="/category/<%= category.category_id %>" class="category-tag">
              <%= category.name %>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p>No categories assigned to this project.</p>
    <% } %>
  </div>
</main>