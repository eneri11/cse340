<%- include('partials/header') %>

<main class="organization-form-container">
  <h1>Edit Organization</h1>

  <form
    action="/edit-organization/<%= organization.organization_id %>"
    method="POST"
  >
    <div class="form-group">
      <label for="name">Organization Name</label>

      <input
        type="text"
        id="name"
        name="name"
        value="<%= organization.name %>"
        maxlength="255"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>

      <textarea id="description" name="description" rows="5">
<%= organization.description || '' %></textarea
      >
    </div>

    <div class="form-group">
      <label for="contact_email">Contact Email</label>

      <input
        type="email"
        id="contact_email"
        name="contact_email"
        value="<%= organization.contact_email || '' %>"
      />
    </div>

    <div class="form-group">
      <label for="logo_filename">Logo Filename</label>

      <input
        type="text"
        id="logo_filename"
        name="logo_filename"
        value="<%= organization.logo_filename || '' %>"
        maxlength="255"
      />
    </div>

    <div class="form-actions">
      <button type="submit">Save Changes</button>

      <a href="/organization/<%= organization.organization_id %>"> Cancel </a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
