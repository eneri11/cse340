<main>
  <% if (organization) { %>
    <!-- Organization Header Details -->
    <h1><%= organization.organization_name || organization.name %></h1>
    
    <% if (organization.description) { %>
      <p><%= organization.description %></p>
    <% endif %>

    <h2>Service Projects</h2>

    <!-- List of projects associated with this organization -->
    <% if (projects && projects.length > 0) { %>
      <ul>
        <% projects.forEach(project => { %>
          <li>
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
            <% if (project.date) { %>
              - <%= new Date(project.date).toLocaleDateString() %>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No service projects found for this organization.</p>
    <% } %>

  <% } else { %>
    <h1>Organization Not Found</h1>
    <p>The organization you are looking for does not exist.</p>
  <% } %>
</main>